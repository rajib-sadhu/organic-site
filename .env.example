# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Database (MySQL). The mariadb driver adapter connects to MySQL fine.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/organic_site"

# Public site URL (used for canonical URLs, emails, Razorpay callbacks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin seed (used once by `npm run db:seed`) ---
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="change-this-strong-password"
SEED_ADMIN_NAME="Store Owner"

# --- Razorpay (Phase 3) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Notifications (ARCHITECTURE §6.14) ---
# Drivers: 'log' (default) sends nothing real — messages go to stdout + the log
# file, so every flow (incl. COD-OTP) works with no external accounts.
EMAIL_DRIVER=log            # log | resend
SMS_DRIVER=log              # log (only driver for v1)
NOTIFICATION_LOG_FILE=logs/notifications.log
# Required only when EMAIL_DRIVER=resend (the server refuses to start without them):
RESEND_API_KEY=""
EMAIL_FROM="Organic Foods <orders@example.com>"

# --- Analytics (src/lib/analytics.ts) ---
# Set either or both. Leave both empty and no tag or cookie banner is shown.
# Tags load only after the visitor accepts the cookie banner.
# If you set both, don't add a GA4 tag inside GTM as well, or events count twice.
NEXT_PUBLIC_GA_ID=""          # GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=""         # GTM container ID, e.g. GTM-XXXXXXX

# --- Auth secret: admin sessions + COD-OTP hashing ---
AUTH_SECRET=""
